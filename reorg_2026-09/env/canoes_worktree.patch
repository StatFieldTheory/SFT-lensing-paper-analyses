+    k3: NDArray[np.float64],
+    z: float,
+) -> NDArray[np.float64]:
+    """Evaluate a user matter-bispectrum callable on one shell, fail loud.
+
+    The callable owns the full redshift dependence: callers must NOT apply
+    the tree-level ``D(z)^4`` scaling on top, because a nonlinear model is
+    not separable in that form.
+
+    Parameters
+    ----------
+    b_delta_fn
+        ``(k1, k2, k3, z) -> B`` with k in h/Mpc and B in (Mpc/h)^6, matter
+        (no Poisson factor: the response product applies A(a) per leg).
+    k1, k2, k3
+        Leg moduli on the Limber quadrature grid of the shell.
+    z
+        Shell redshift.
+    """
+    values = np.asarray(b_delta_fn(k1, k2, k3, z), dtype=np.float64)
+    if values.shape != k1.shape:
+        raise ValueError(
+            f"b_delta_fn returned shape {values.shape}, expected {k1.shape}"
+        )
+    if not np.all(np.isfinite(values)):
+        n_bad = int(np.count_nonzero(~np.isfinite(values)))
+        raise ValueError(
+            f"b_delta_fn returned {n_bad} non-finite values at z={z:.4f}"
+        )
+    return values
+
