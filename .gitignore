# .gitignore for the SFT-lensing-paper-analyses repository.
# This folder is its own git repo (separate from the parent paper repo, which
# git-ignores it). Keep the repo lean: code + small live data + docs only.

# Python / tooling caches (regenerable)
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# OS cruft
.DS_Store

# sft-wick computation caches (regenerable; not needed once xi_*.npz exist)
**/.cache_expand_*/
**/.cache_propagators_*/

# Frozen local archives — large, NOT for GitHub.
# _archive/ holds the 773 MB superseded limber C-table and the 161 MB canoes
# pipeline; both exceed GitHub's 100 MB per-file limit. Kept locally only.
_archive/
**/_cleanup_archive_*/

# scratch
*.npz.tmp

# Agent-generated scratch/handoff/prompt docs (kept locally, not for GitHub).
# These are working notes from agent sessions, not pipeline artifacts.

# Agent prompts and working notes co-located with analysis code.
**/PROMPT*.md
**/*_NOTES.md
**/*_notes*.md
sachs_sft/analyses/shear3pcf_fastnc/scripts
# driver_field_emulators, imported 2026-09-02 during the reproducibility reorganisation.
# Large regenerable products, exploratory variants and private material stay out of git;
# every excluded file is listed with its md5 in reorg_2026-09/dfe_manifest_2026-09-02.txt.
driver_field_emulators/products/pieces/
driver_field_emulators/products/_ff_caches/
driver_field_emulators/products/_ff_dt1/
driver_field_emulators/products/cutoff_vertex.npz
driver_field_emulators/products/cutoff_vertex_tree.npz
driver_field_emulators/products/cutoff_study_partial.npz
driver_field_emulators/products/_variant_collapsed_dense_*/
driver_field_emulators/products/collapsed_dense_*
driver_field_emulators/products/collapsed_triples_dense.npz
driver_field_emulators/products/_low_cache_collapsed_dense.npz
driver_field_emulators/products/table_tree_cut1000_r*
driver_field_emulators/products/_variant_table_tree_cut1000_*/
driver_field_emulators/products/table_permclosed_cut1000*
driver_field_emulators/products/_variant_table_permclosed_cut1000_*/
driver_field_emulators/products/table_reproduce_deployed*
driver_field_emulators/products/_variant_table_reproduce_deployed/
driver_field_emulators/products/triples_full_r1.npz
driver_field_emulators/products/triples_full_r2.npz
driver_field_emulators/products/triples_permclosed_r1.npz
driver_field_emulators/products/triples_permclosed_r2.npz
driver_field_emulators/products/triples_collapsed_only.npz
driver_field_emulators/products/triples_production_only.npz
driver_field_emulators/products/triples_permutation_probe.npz
driver_field_emulators/products/xi_FF_dt1.npz
driver_field_emulators/products/_l2_lambda_grid_*.npz
driver_field_emulators/products/xi_kappa_channels_preRevision.pdf
driver_field_emulators/products/multiz_kappa_2pcf_5z_preRevision.npz
driver_field_emulators/figures/corrected/
driver_field_emulators/papers/
driver_field_emulators/revision_plan/
driver_field_emulators/code/mc_fk_complete/psd_fix/**/*.npz
driver_field_emulators/note/*.aux
driver_field_emulators/note/*.log
driver_field_emulators/note/*.fdb_latexmk
driver_field_emulators/note/*.fls
driver_field_emulators/note/*.out
driver_field_emulators/note/*.toc
**/.benchmarks/

# vertex-rebuild intermediates (octave-band pieces, hours of canoes builds; regenerable, listed with md5 in reorg_2026-09/dfe_manifest_2026-09-02.txt)
**/products/pieces/
**/_ff_caches/

# vertex-level cutoff study (audit-note data, 6 MB, regenerable from the band pieces)
**/fk_audit_2026-08/products/cutoff_*.npz

# docs/: the agent briefs are tracked here although PROMPT*.md is ignored elsewhere;
# the arXiv PDFs and the editor correspondence stay out of git.
!docs/agent_briefs/*.md
docs/papers/
docs/private/

# Rendered figures produced by reproduce/regen_figure.py. They are rewritten on every
# run and duplicate the deployed copies in the manuscript's figures/, whose md5 sums are
# the contract in reproduce/deployed_md5.txt. Tracking them recreates the stale-twin
# problem the 2026-09 reorganisation removed. The DATA under outputs/ stays tracked:
# the npz intermediates cost minutes to hours to rebuild.
figures/outputs/*.pdf
figures/outputs/*.png
sachs_sft/analyses/analysis1/outputs/*.pdf
sachs_sft/analyses/analysis1/outputs/*.png
sachs_sft/analyses/analysis3/outputs/*.pdf
sachs_sft/analyses/analysis3/outputs/*.png
sachs_sft/analyses/mc_sachs_2pt/figures/*.pdf
sachs_sft/analyses/mc_sachs_2pt/figures/*.png
sachs_sft/callables/kappa3_vertex/equal_time_limber/outputs/*.pdf
sachs_sft/callables/kappa3_vertex/equal_time_limber/outputs/*.png
sachs_sft/callables/kappa3_vertex/rebuild/outputs/*.pdf
sachs_sft/callables/kappa3_vertex/rebuild/outputs/*.png

# n_phi=512 vertex rebuild, 2026-09-06. Same convention as products/pieces/ above:
# the octave-band intermediates are ~26 MB of regenerable canoes output (4.5 h at
# 8-way), excluded and recorded with md5 in reorg_2026-09/nphi512_manifest_2026-09-06.txt.
# The assembled table, the folds and the multi-z product ARE tracked: they are small
# and they are what every downstream number reads.
**/products/pieces_nphi512/band_tree_*.npz
**/products/pieces_nphi512/ladder/table_tree_np512_cut*.npz
# but keep the folds: they are 13 KB each and are the measured ladder rungs
!**/products/pieces_nphi512/ladder/table_tree_np512_cut*_xi.npz
**/products/pieces_nphi512/_variant_*/
**/products/pieces_nphi512/ladder/_variant_*/
# multiz_sweep.py's scratch area; the tracked multi-z deliverable is
# pieces_nphi512/multiz_fk_np512_6planes.npz
**/outputs/_multiz_scratch/

# R1 revision: keep accepted numerical arrays, configurations and validation records.
# Rendered previews, process caches and local rollback snapshots are regenerable.
sachs_sft/analyses/r1_sft061/deployment_archive_2026-09-28/paper_snapshot/
sachs_sft/analyses/r1_sft061/figure_previews/
sachs_sft/analyses/r1_sft061/**/*.joblib
sachs_sft/analyses/r1_sft061/**/*.lock
sachs_sft/analyses/r1_sft061/**/*.log
sachs_sft/analyses/analysis1/r1_aligned/**/*.pdf
sachs_sft/analyses/analysis1/r1_aligned/**/*.png
sachs_sft/analyses/analysis1/r1_aligned/**/*.log
sachs_sft/analyses/analysis1/r1_aligned/outputs/comparison_final/archive_*/
